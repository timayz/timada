# What a refusal says to a shopper: one sentence for each code the shop
# answers with (see `say` in mod.rs).

error_invalid_quantity = Choose a quantity from 1 to 99.
error_too_many_lines = Your cart is full: order what it holds first.
error_product_unavailable = Sorry, this product is no longer on sale.
error_out_of_stock = Sorry, there are not enough left.
error_variant_required = Choose an option first.
error_variant_not_found = This combination is not on sale.
error_mixed_currencies = This product is sold in another currency than your cart.
error_empty_cart = Your cart is empty.
error_price_changed = A price has changed since your visit: check the new total and confirm again.
error_payments_unavailable = Payment is unavailable for the moment. Try again later.
error_invoicing_not_configured = This shop cannot take orders yet: its setup is not finished. Try again later.
error_oss_required_for_currency = This shop cannot deliver to your country in this currency. Choose a delivery in France or contact the shop.
error_payment_failed = The payment did not go through. Try again or use another card.
error_payment_expired = This payment is no longer open. Please start your order again.
error_payment_returned_out_of_stock = The last one went while you were paying: nothing was charged. Your cart is unchanged.
error_payment_returned_discount_exhausted = This promo code ran out while you were paying: nothing was charged. Remove the code and try again.
error_payment_returned_discount_already_used = This promo code was already used for your address: nothing was charged. Remove the code and try again.
error_invalid_email = Enter a valid e-mail address.
error_invalid_vat_number = Enter an EU VAT number: the country prefix, then letters and digits.
error_shipping_unavailable = Choose a delivery method that serves your country.
error_business_buyers_refused = This shop does not sell to businesses: leave the VAT number empty.
error_invalid_ship_name = Enter the recipient's name.
error_invalid_address = Enter the street, the postal code and the city.
error_invalid_country = Enter the country as a two-letter code, for example FR.
error_invalid_phone = The phone number is too long.
error_missing_phone = Give a phone number: the carrier may need to reach you.
error_invalid_note = The note is too long.
error_cart_checked_out = This cart has already been ordered.
error_cart_not_found = This cart no longer exists: add your items again.
error_too_many_carts = Too many carts started in a short time: try again in a few minutes.
error_discount_unknown = This promo code is not valid.
error_discount_inactive = This promo code cannot be used for the moment.
error_discount_currency = This promo code is for another currency.
error_discount_exhausted = This promo code has been used as many times as it could be.
error_discount_already_used = You have already used this promo code.
error_offer_ended = This offer is no longer available: the item was added at its usual price.
error_review_invalid_rating = Choose from one to five stars.
error_review_invalid_title = The title is 100 characters at most.
error_review_invalid_body = Tell us a little more: from 10 to 2000 characters.
error_review_too_many_photos = Attach three photos at most.
error_review_invalid_photo = Attach JPEG, PNG, WebP or GIF photos of 8 MiB at most.
error_review_storage_full = The shop cannot take photos for the moment: send your review without a photo.
error_review_order_not_found = This order cannot be reviewed.
error_review_not_purchased = This product is not part of this order.
error_review_order_cancelled = A cancelled order cannot be reviewed.
error_review_order_not_paid = An order is reviewed once it is confirmed.
error_order_in_preparation = The shop is already preparing your order: it can no longer be cancelled here. Contact the shop.
error_not_cancellable = This order has left: it can no longer be cancelled.
error_order_cancelled = This order is already cancelled.
error_cancellation_pending = Your order is being cancelled.
error_review_already_reviewed = You have already reviewed this product.
error_review_not_pending = The shop has already looked at your review: it can no longer be changed.
error_review_not_found = This review cannot be found.
error_review_photo_not_found = One of your photos was removed in the meantime: try again.
error_wrong_code = This is not the code we sent. Check the e-mail and try again.
error_code_expired = This code has expired: ask for a new one.
error_too_many_attempts = Too many wrong codes: ask for a new one.
error_code_recently_sent = A code was sent less than a minute ago: check your inbox.
error_too_many_requests = Too many codes asked for: try again in a few minutes.
error_too_many_addresses = Your account keeps ten addresses: remove one first.
error_signed_out = You have been signed out. Please sign in again.
error_store_unavailable = This feature is unavailable for a moment. Try again in a few minutes.
error_writes_paused = This shop takes no change for a moment. Try again in a few minutes.
error_write_not_taken = Your request did not go through and nothing was saved. Please try again.
error_unknown = Something went wrong. Please try again.
